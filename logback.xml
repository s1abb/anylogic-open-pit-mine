<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <!-- Console Appender -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>[%d{HH:mm:ss}] [%thread] %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- File Appender -->
  <appender name="FILE" class="ch.qos.logback.core.FileAppender">
    <file>anylogic.log</file>
    <append>false</append>
    <encoder>
      <pattern>[%d{yyyy-MM-dd HH:mm:ss}] [%thread] %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- Suppress Jetty and Spark DEBUG logs -->
  <logger name="org.eclipse.jetty" level="OFF"/>
  <logger name="org.eclipse.jetty.server" level="OFF"/>
  <logger name="org.eclipse.jetty.http" level="OFF"/>
  <logger name="org.eclipse.jetty.io" level="OFF"/>
  <logger name="sparkjava" level="OFF"/>
  <logger name="spark" level="OFF"/>
  <logger name="com.anylogic" level="WARN"/>
  <logger name="DataDriver" level="INFO"/>
  <logger name="a_Network" level="INFO"/>
  <logger name="Main" level="INFO"/>

  <!-- Root Logger -->
  <root level="WARN">
    <appender-ref ref="CONSOLE" />
    <appender-ref ref="FILE" />
  </root>

</configuration>

