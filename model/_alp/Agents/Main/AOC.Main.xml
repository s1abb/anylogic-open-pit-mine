	<StartupCode><![CDATA[// Create NetworkBuilder and parse OBJ file
NetworkBuilder builder = new NetworkBuilder();
builder.setCoordinateTransform(CoordinateTransform.createDefaultTransform());
builder.parseOBJFile("../network/network_with_elevation.obj");
builder.applyEdgeCorrections("./edges_list_corrected.csv");
builder.saveJSONToFile("./network.json");
builder.saveEdgesCSV("./edges_list_default.csv");

// Set JSON file path in network agent
p_Network.jsonFilePath = "./network.json";

// Load data using DataDriver
p_Network.loadDataFromJson();

// Initialize network visualization
p_Network.initializeNetwork();
presentation.add(p_Network.v_Level);

try {
    DataDriver loadingPointsDriver = new DataDriver();
    loadingPointsDriver.initialiseFromCSV(
        () -> {
            LoadingPoint lp = this.add_p_loadingPoints();
            lp.nodesRef = p_Network.p_Nodes;
            return lp;
        },
        "../input/loading_points.csv",
        true
    );
    loadingPointsDriver.callOnParametersSet();
    loadingPointsDriver.callOnRunStarted();
} catch (InputException e) {
    logger.error("Error loading loading points CSV: {}", e.getMessage(), e);
}

try {
    DataDriver dumpingPointsDriver = new DataDriver();
    dumpingPointsDriver.initialiseFromCSV(
        () -> {
            DumpingPoint dp = this.add_p_dumpingPoints();
            dp.nodesRef = p_Network.p_Nodes;
            return dp;
        },
        "../input/dumping_points.csv",
        true
    );
    dumpingPointsDriver.callOnParametersSet();
    dumpingPointsDriver.callOnRunStarted();
} catch (InputException e) {
    logger.error("Error loading dumping points CSV: {}", e.getMessage(), e);
    traceln("Error loading dumping points CSV: " + e.getMessage());
}

try {
    DataDriver homeNodesDriver = new DataDriver();
    homeNodesDriver.initialiseFromCSV(
        () -> {
            HomeNode hp = this.add_p_homeNodes();
            hp.nodesRef = p_Network.p_Nodes;
            return hp;
        },
        "../input/home_points.csv",
        true
    );
    homeNodesDriver.callOnParametersSet();
    homeNodesDriver.callOnRunStarted();
} catch (InputException e) {
    logger.error("Error loading home points CSV: {}", e.getMessage(), e);
    traceln("Error loading home points CSV: " + e.getMessage());
}
loadTaskMatrix("../input/task_matrix.csv");
onRunInitialised();
logger.info("Trucks in population after inject: {}", p_dumpTrucks.size());]]></StartupCode>
