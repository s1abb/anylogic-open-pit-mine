						<Parameter>
							<Name><![CDATA[onExit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[if (agent.currentTask == Task.TO_LOAD) {
    for (LoadingPoint lp : p_loadingPoints) {
        if (lp.pool != null && !agent.resourceUnitsOfPool(lp.pool).isEmpty()) {
            agent.currentLoadingPoint = lp;
            break;
        }
    }
} else if (agent.currentTask == Task.TO_DUMP) {
    for (DumpingPoint dp : p_dumpingPoints) {
        if (dp.pool != null && !agent.resourceUnitsOfPool(dp.pool).isEmpty()) {
            agent.currentDumpingPoint = dp;
            break;
        }
    }
}

if (agent.currentTask == Task.TO_LOAD && agent.currentLoadingPoint != null) {
    logger.info("Truck seized loading point: {}", agent.currentLoadingPoint.id);
} else if (agent.currentTask == Task.TO_DUMP && agent.currentDumpingPoint != null) {
    logger.info("Truck seized dumping point: {}", agent.currentDumpingPoint.id);
}]]></Code>
							</Value>
