							<Value Class="CodeValue">
								<Code><![CDATA[TaskEvent arrivalEvent =
    agent.currentTask == Task.TO_LOAD ? TaskEvent.LOADING_ARRIVAL :
    agent.currentTask == Task.TO_DUMP ? TaskEvent.DUMPING_ARRIVAL :
    TaskEvent.HOME_ARRIVAL;
Task result = nextTask(arrivalEvent, shiftActive);
agent.currentTask = result;
logger.info("Truck arrived, task now: {}", agent.currentTask);]]></Code>
