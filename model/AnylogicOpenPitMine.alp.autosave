			<AdditionalClassCode><![CDATA[private static final Logger logger = LogManager.getLogger("a_Edge");

// Inner class for vertex points
public static class VertexPoint {
    public double x, y, z;
    
    public VertexPoint(double x, double y, double z) {
        this.x = x;
        this.y = y;
        this.z = z;
    }
}

