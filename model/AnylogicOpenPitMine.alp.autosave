			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1789547667834</Id>
					<Name><![CDATA[onRunInitialised]]></Name>
					<X>-250</X><Y>350</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[traceln("onRunInitialised() called");
source.inject(numDumpTrucks);
traceln("Trucks in population after inject: " + p_dumpTrucks.size());
DumpTruck t = p_dumpTrucks.get(0);
traceln("First truck at: " + t.getX() + ", " + t.getY() + ", " + t.getZ());]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[ResourcePool[][]]]></ReturnType>
					<Id>1789548528511</Id>
					<Name><![CDATA[buildLoadingPointResourceSets]]></Name>
					<X>-250</X><Y>400</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[List<ResourcePool[]> sets = new ArrayList<>();
for (LoadingPoint lp : p_loadingPoints) {
    if (lp.pool != null) {
        sets.add(new ResourcePool[]{ lp.pool });
    }
}
return sets.toArray(new ResourcePool[0][]);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[a_Node]]></ReturnType>
					<Id>1789608877713</Id>
					<Name><![CDATA[findANodeById]]></Name>
					<X>-250</X><Y>550</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[nodeId]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[return p_Network.p_Nodes.stream()
    .filter(n -> n.id.equals(nodeId))
    .findFirst()
    .orElse(null);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[ResourcePool[][]]]></ReturnType>
					<Id>1789634291281</Id>
					<Name><![CDATA[buildDumpingPointResourceSets]]></Name>
					<X>-250</X><Y>450</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[List<ResourcePool[]> sets = new ArrayList<>();
for (DumpingPoint dp : p_dumpingPoints) {
    if (dp.pool != null) {
        sets.add(new ResourcePool[]{ dp.pool });
    }
}
return sets.toArray(new ResourcePool[0][]);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1789634749929</Id>
					<Name><![CDATA[loadTaskMatrix]]></Name>
					<X>-250</X><Y>600</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[csvFilePath]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[taskMatrix = new Task[TaskEvent.values().length][2];
try (BufferedReader reader = new BufferedReader(new FileReader(csvFilePath))) {
    CSVParser parser = CSVParser.parse(reader, CSVFormat.DEFAULT.withFirstRecordAsHeader());
    for (CSVRecord record : parser) {
        TaskEvent event = TaskEvent.valueOf(record.get("event"));
        boolean shift = Boolean.parseBoolean(record.get("shiftActive"));
        Task task = Task.valueOf(record.get("nextTask"));
        taskMatrix[event.ordinal()][shift ? 1 : 0] = task;
    }
} catch (IOException e) {
    logger.error("Error loading task matrix: {}", e.getMessage(), e);
    traceln("Error loading task matrix: " + e.getMessage());
}]]></Body>
